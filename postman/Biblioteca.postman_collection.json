{
  "info": {
    "name": "Biblioteca - microservicio generado con arquetipo (DSY2205 S4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/libros"
    },
    {
      "key": "libroId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "GET - Obtener todos los libros",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Obtener libro por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Agregar libro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Rayuela\",\n  \"autor\": \"Julio Cortázar\",\n  \"anioPublicacion\": 1963,\n  \"genero\": \"Novela\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('libroId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT - Actualizar libro",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/{{libroId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Rayuela (edición conmemorativa)\",\n  \"autor\": \"Julio Cortázar\",\n  \"anioPublicacion\": 1963,\n  \"genero\": \"Novela experimental\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Ver libro actualizado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/{{libroId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE - Eliminar libro",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/{{libroId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Error 404 - Libro inexistente",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/99999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 404', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Error 400 - Datos inválidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"\",\n  \"autor\": \"Sin título\",\n  \"genero\": \"Novela\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    }
  ]
}